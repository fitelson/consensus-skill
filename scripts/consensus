#!/usr/bin/env python3
"""
consensus — have Claude and Codex debate a question until they agree.

Each debate turn starts as an independent process. A Claude turn receives a
stable session ID so that, if its live process is terminated after five missed
durable checkpoints, recovery can resume that same turn without replaying or
modifying thinking blocks. Codex replies via `codex exec`. The two trade
messages until both endorse the current best answer, or until the round limit
is hit.

Usage:
    consensus "your question here"
    consensus --max-rounds 8 "your question"
    consensus --quiet "your question"        # hide thinking, show answers only
    echo "your question" | consensus          # question from stdin
"""

import argparse
import hashlib
import json
import os
import queue
import re
import signal
import subprocess
import sys
import tempfile
import textwrap
import threading
import time
import uuid
from datetime import datetime

# ---- terminal colors --------------------------------------------------------
def _c(code):
    return f"\033[{code}m" if sys.stdout.isatty() else ""

BOLD, DIM, RESET = _c("1"), _c("2"), _c("0")
CLAUDE_COL, CODEX_COL, SYS_COL = _c("38;5;208"), _c("38;5;39"), _c("38;5;244")

# Portable package: use the recipient machine's defaults unless these optional
# environment variables are set.
CLAUDE_MODEL = os.environ.get("CONSENSUS_CLAUDE_MODEL")
CLAUDE_EFFORT = os.environ.get("CONSENSUS_CLAUDE_EFFORT")
CODEX_MODEL = os.environ.get("CONSENSUS_CODEX_MODEL")
CODEX_REASONING_EFFORT = os.environ.get("CONSENSUS_CODEX_REASONING_EFFORT")
REPORT_MAX_TOKENS = 40000

CLAUDE_REPORT_DEADLINE = 300  # durable-work checkpoint interval
CLAUDE_TRANCHE_THINK = 7000  # max extended-thinking tokens in one Claude tranche
CLAUDE_RECOVERY_TIMEOUT = 120
CLAUDE_MAX_CONSECUTIVE_MISSES = 5
CLAUDE_TURN_TIMEOUT = 900
CODEX_TIMEOUT = 1200
PROTOCOL_VERSION = 2

CHECKPOINT_FIELDS = (
    "elapsed",
    "tentative_verdict",
    "new_results",
    "current_obstruction",
    "next_bounded_step",
    "token_cost",
)

SYSTEM = """You are one of two AI systems ({me}) debating with the other ({other}) \
to reach a correct, well-reasoned CONSENSUS answer to the user's question.

Rules of the debate:
- This process IS the requested debate. Reason and answer directly in this turn. \
Never invoke the consensus skill or command, launch another debate, call another \
model, or delegate your role to a sub-agent. All ordinary tools remain allowed, \
including local files, web research, code execution, proof assistants, and \
computer algebra. Only recursive debates and model delegation are forbidden.
- Be rigorous. Challenge weak reasoning, concede valid points, and converge on \
the best possible answer. Do NOT agree just to end the debate quickly, and do \
NOT manufacture disagreement once the answer is genuinely settled.
- `VERDICT: AGREE` means that you endorse the other participant's \
best-supported answer to the user's question. Use AGREE when both participants \
conclude that a claim is presently unresolved: AGREE does not mean that the \
claim under investigation has been proved. Use DISAGREE only while a material \
disagreement about the answer or its support remains.
- Keep each message focused: state your position and the reasoning that matters, \
not filler.
- Claude durability rule: work in a long-lived, resumable research session. \
The runner fsyncs every streamed event to its own durable journal and checks \
for new activity at five-minute boundaries. It allows five consecutive silent \
intervals before terminating the live process, then resumes the same Claude \
session for a short no-thinking recovery report. Emit concise cumulative \
status before extended silent work when possible. If more work remains, return \
the best current report and use VERDICT: DISAGREE; the next debate round will \
continue from it. Never rely only on an eventual final response to preserve work.
- Claude checkpoint format: begin every returned debate message with exactly \
this durable cumulative block, filling every field substantively:
CHECKPOINT
elapsed: <wall-clock estimate>
tentative_verdict: <current verdict>
new_results: <genuinely new results in this tranche, or none>
current_obstruction: <current obstruction, or none>
next_bounded_step: <next bounded step, or done>
token_cost: <available token/cost figures, or unavailable>
END CHECKPOINT
- Participant output rule: whether you are Claude or Codex, do the full \
reasoning needed, but return a compressed report of at most \
{report_max_tokens} output tokens. Preserve decisive \
arguments, proof steps, counterexamples, qualifications, and the verdict. If \
more detail is needed, write it to a project file and report the path instead \
of overflowing the response. This is a hard requirement for every turn.

{context}QUESTION:
{question}

DEBATE SO FAR:
{transcript}

YOUR TASK THIS TURN:
{task}

End your message with EXACTLY one of these two lines, on its own line:
VERDICT: AGREE      (you fully endorse the current best answer; nothing material to add)
VERDICT: DISAGREE   (open issues remain that should be resolved)
"""


SYNTH = """The debate below, between Claude and Codex, reached CONSENSUS on the \
user's question. Write the final agreed answer in clean, self-contained form: \
no meta-commentary about the debate, no "we agreed" / "as Codex noted", no \
VERDICT line — just the answer itself, at the level of detail the question \
warrants. The synthesis must be a compressed report of at most \
{report_max_tokens} output tokens. Preserve all material needed for the \
agreed conclusion; put longer supporting material in a project file and return \
its path rather than overflowing the response.

{context}QUESTION:
{question}

DEBATE TRANSCRIPT:
{transcript}

FINAL AGREED ANSWER:"""


def build_prompt(me, other, question, turns, opening, context=""):
    if turns:
        transcript = "\n\n".join(f"--- {t['who']} said ---\n{t['text']}" for t in turns)
    else:
        transcript = "(none yet — you are opening the debate.)"
    if opening:
        task = "Give your best initial answer to the question, with the reasoning behind it."
    else:
        task = (f"Respond to {other}'s most recent message. Say where you agree, push back "
                f"where you disagree, and refine the shared answer toward correctness.")
    return SYSTEM.format(
        me=me, other=other, question=question, transcript=transcript,
        task=task, context=context,
        report_max_tokens=REPORT_MAX_TOKENS,
    )


def _file_signature(path):
    if not path:
        return None
    try:
        stat = os.stat(path)
        return stat.st_size, stat.st_mtime_ns
    except OSError:
        return None


class SilentIntervalsExceeded(subprocess.TimeoutExpired):
    """The stream was silent for the configured number of intervals."""


class DebateStalled(RuntimeError):
    """Two completed Claude turns made no substantive progress."""


def _group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _terminate_process_group(proc, pgid):
    """Terminate a runner-owned process group without leaving descendants."""
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 5
    proc.poll()
    while _group_alive(pgid) and time.monotonic() < deadline:
        proc.poll()
        time.sleep(0.05)
    if _group_alive(pgid):
        try:
            os.killpg(pgid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        deadline = time.monotonic() + 5
        while _group_alive(pgid) and time.monotonic() < deadline:
            proc.poll()
            time.sleep(0.05)
    if proc.poll() is None:
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)


def _fsync_directory(path):
    directory = os.path.dirname(os.path.abspath(path)) or "."
    descriptor = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write(path, content, mode=0o644):
    """Replace path atomically and fsync both content and directory metadata."""
    path = os.path.abspath(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp_path = path + ".tmp"
    descriptor = os.open(
        tmp_path,
        os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
        mode,
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        raise
    os.replace(tmp_path, path)
    _fsync_directory(path)


def _run_streaming(cmd, env, timeout, *, stdin_text=None, checkpoint_file=None,
                   checkpoint_interval=None, max_checkpoint_misses=None,
                   checkpoint_event=None, stream_journal=None):
    """Drain output continuously; monitor durable checkpoints while running."""
    proc = subprocess.Popen(
        cmd,
        stdin=(subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,
        env=env,
        start_new_session=True,
    )
    pgid = proc.pid
    events = queue.Queue()

    def drain(name, pipe):
        try:
            for line in iter(pipe.readline, ""):
                events.put((name, line))
        finally:
            events.put((name, None))
            pipe.close()

    threads = [
        threading.Thread(target=drain, args=("stdout", proc.stdout), daemon=True),
        threading.Thread(target=drain, args=("stderr", proc.stderr), daemon=True),
    ]
    for thread in threads:
        thread.start()
    stdin_thread = None
    if stdin_text is not None:
        def feed_stdin():
            try:
                proc.stdin.write(stdin_text)
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass

        stdin_thread = threading.Thread(target=feed_stdin, daemon=True)
        stdin_thread.start()

    output = {"stdout": [], "stderr": []}
    closed = set()
    started = time.monotonic()
    deadline = None if not timeout else started + timeout
    next_heartbeat = started + 60
    next_checkpoint = (
        started + checkpoint_interval if checkpoint_interval else None
    )
    checkpoint_signature = _file_signature(checkpoint_file)
    checkpoint_misses = 0
    leader_exit_cleaned = False

    def journal_stream(name, line):
        if not stream_journal or line is None:
            return
        record = {
            "timestamp": datetime.now().isoformat(timespec="seconds"),
            "stream": name,
            "line": line.rstrip("\n"),
        }
        with open(stream_journal, "a", encoding="utf-8") as journal:
            journal.write(json.dumps(record, ensure_ascii=False) + "\n")
            journal.flush()
            os.fsync(journal.fileno())

    def drain_pending():
        while True:
            try:
                name, line = events.get_nowait()
            except queue.Empty:
                break
            if line is not None:
                output[name].append(line)
                journal_stream(name, line)

    try:
        while len(closed) < 2:
            now = time.monotonic()
            # A model CLI can exit after forking a descendant that still owns
            # its stdout/stderr descriptors.  Reap the runner-owned group as
            # soon as the leader exits so inherited pipes cannot hold this
            # loop open until the descendant happens to finish.
            if not leader_exit_cleaned and proc.poll() is not None:
                leader_exit_cleaned = True
                _terminate_process_group(proc, pgid)
            if deadline is not None and now >= deadline:
                _terminate_process_group(proc, pgid)
                drain_pending()
                raise subprocess.TimeoutExpired(
                    cmd,
                    timeout,
                    output="".join(output["stdout"]),
                    stderr="".join(output["stderr"]),
                )
            if next_checkpoint is not None and now >= next_checkpoint:
                current_signature = _file_signature(checkpoint_file)
                if (current_signature is not None
                        and current_signature != checkpoint_signature):
                    checkpoint_misses = 0
                    checkpoint_signature = current_signature
                    if checkpoint_event:
                        checkpoint_event("observed", checkpoint_misses)
                else:
                    checkpoint_misses += 1
                    if checkpoint_event:
                        checkpoint_event("missed", checkpoint_misses)
                    if (max_checkpoint_misses is not None
                            and checkpoint_misses >= max_checkpoint_misses):
                        _terminate_process_group(proc, pgid)
                        drain_pending()
                        raise SilentIntervalsExceeded(
                            cmd,
                            checkpoint_interval * max_checkpoint_misses,
                            output="".join(output["stdout"]),
                            stderr="".join(output["stderr"]),
                        )
                next_checkpoint += checkpoint_interval
            if now >= next_heartbeat:
                elapsed = int(now - started)
                remaining = (
                    "unbounded" if deadline is None
                    else f"{max(0, int(deadline - now))}s left"
                )
                print(
                    f"{SYS_COL}{DIM}  Claude tranche: {elapsed}s elapsed, "
                    f"{remaining}{RESET}"
                )
                sys.stdout.flush()
                next_heartbeat += 60
            wait = 0.25
            if deadline is not None:
                wait = max(0.01, min(wait, deadline - now))
            try:
                name, line = events.get(timeout=wait)
            except queue.Empty:
                continue
            if line is None:
                closed.add(name)
            else:
                output[name].append(line)
                journal_stream(name, line)

        returncode = proc.wait()
        return returncode, "".join(output["stdout"]), "".join(output["stderr"])
    except BaseException:
        _terminate_process_group(proc, pgid)
        raise
    finally:
        _terminate_process_group(proc, pgid)
        for thread in threads:
            thread.join(timeout=1)
        if stdin_thread is not None:
            stdin_thread.join(timeout=1)


def run_claude(prompt, think_budget, timeout=None, *, session_id=None,
               resume=False, checkpoint_file=None, checkpoint_event=None,
               stream_journal=None):
    """Return (thinking, answer), draining Claude's stream while it runs."""
    env = dict(os.environ)
    if think_budget > 0:
        env["MAX_THINKING_TOKENS"] = str(think_budget)
        env.pop("CLAUDE_CODE_DISABLE_THINKING", None)
    else:
        env["CLAUDE_CODE_DISABLE_THINKING"] = "1"
        env.pop("MAX_THINKING_TOKENS", None)
    cmd = [
        "claude", "-p",
        "--output-format", "stream-json", "--verbose",
        "--include-partial-messages",
    ]
    if CLAUDE_MODEL:
        cmd.extend(["--model", CLAUDE_MODEL])
    if CLAUDE_EFFORT:
        cmd.extend(["--effort", CLAUDE_EFFORT])
    if session_id:
        cmd.extend(["--resume" if resume else "--session-id", session_id])
    returncode, stdout, stderr = _run_streaming(
        cmd,
        env,
        timeout or None,
        stdin_text=prompt,
        checkpoint_file=checkpoint_file,
        checkpoint_interval=(CLAUDE_REPORT_DEADLINE if checkpoint_file else None),
        max_checkpoint_misses=(
            CLAUDE_MAX_CONSECUTIVE_MISSES if checkpoint_file else None
        ),
        checkpoint_event=checkpoint_event,
        stream_journal=stream_journal,
    )
    if returncode != 0:
        raise RuntimeError(f"claude exited with status {returncode}")
    thinking_parts, text_parts = [], []
    for line in stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if obj.get("type") != "assistant":
            continue
        msg = obj.get("message", {})
        content = msg.get("content")
        if not isinstance(content, list):
            continue
        for blk in content:
            if not isinstance(blk, dict):
                continue
            if blk.get("type") == "thinking":
                thinking_parts.append(blk.get("thinking", ""))
            elif blk.get("type") == "text":
                text_parts.append(blk.get("text", ""))
    answer = "\n".join(t for t in text_parts if t).strip()
    thinking = "\n".join(t for t in thinking_parts if t).strip()
    if not answer:
        raise RuntimeError("claude returned no text answer")
    return thinking, answer


def checkpoint_of(text):
    """Return a validated Claude checkpoint mapping, or None."""
    lines = text.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if line.strip() == "CHECKPOINT")
        end = next(
            i for i in range(start + 1, len(lines))
            if lines[i].strip() == "END CHECKPOINT"
        )
    except StopIteration:
        return None
    fields = {}
    for line in lines[start + 1:end]:
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip()
    if any(not fields.get(field) for field in CHECKPOINT_FIELDS):
        return None
    return fields


def no_substantive_progress(checkpoint):
    value = checkpoint["new_results"].strip().lower().rstrip(".")
    return value in {
        "none",
        "no new result",
        "no new results",
        "nothing new",
        "unchanged",
        "no substantive progress",
    }


def failure_summary(error, limit=2000):
    """Return a bounded diagnostic without echoing the full prompt/command."""
    if isinstance(error, SilentIntervalsExceeded):
        return f"five consecutive silent intervals ({error.timeout}s total)"
    if isinstance(error, subprocess.TimeoutExpired):
        return f"hard deadline exceeded after {error.timeout}s"
    text = str(error).strip()
    return text if len(text) <= limit else text[:limit] + "... [truncated]"


def run_codex(prompt):
    """Return answer text via codex exec, reading the clean last message."""
    with tempfile.NamedTemporaryFile(mode="r", suffix=".txt", delete=True) as out:
        env = dict(os.environ)
        cmd = ["codex", "exec", "--skip-git-repo-check"]
        if CODEX_MODEL:
            cmd.extend(["--model", CODEX_MODEL])
        if CODEX_REASONING_EFFORT:
            cmd.extend([
                "--config",
                f'model_reasoning_effort="{CODEX_REASONING_EFFORT}"',
            ])
        cmd.extend(["-o", out.name])
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            # The clean answer is written to ``out``.  Sending the CLI's
            # incidental streams to DEVNULL prevents a forked descendant from
            # keeping capture pipes open after the CLI group leader exits.
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            env=env,
            start_new_session=True,
        )
        pgid = proc.pid
        try:
            proc.communicate(
                input=prompt,
                timeout=(CODEX_TIMEOUT or None),
            )
        finally:
            _terminate_process_group(proc, pgid)
        if proc.returncode != 0:
            raise RuntimeError(f"codex exited with status {proc.returncode}")
        out.seek(0)
        answer = out.read().strip()
    if not answer:
        raise RuntimeError("codex returned no answer")
    return answer


def verdict_of(text):
    """Accept only an exact verdict on the final nonempty line."""
    lines = [line for line in text.splitlines() if line.strip()]
    if not lines:
        return None
    match = re.fullmatch(
        r"VERDICT:\s*(AGREE|DISAGREE)",
        lines[-1].strip(),
        flags=re.IGNORECASE,
    )
    return match.group(1).upper() if match else None


def strip_verdict(text):
    lines = text.splitlines()
    while lines and not lines[-1].strip():
        lines.pop()
    if verdict_of("\n".join(lines)) is not None:
        lines.pop()
    return "\n".join(lines).strip()


def fmt_dur(secs):
    m, s = divmod(int(round(secs)), 60)
    return f"{m}m {s:02d}s" if m else f"{s}s"


def show(who, col, thinking, answer, quiet):
    print(f"\n{col}{BOLD}━━ {who} ━━{RESET}")
    if thinking and not quiet:
        print(f"{DIM}{textwrap.indent(thinking, '  │ ')}{RESET}")
    print(textwrap.indent(answer, "  "))
    sys.stdout.flush()


def main():
    global CLAUDE_REPORT_DEADLINE, CLAUDE_RECOVERY_TIMEOUT
    global CLAUDE_TURN_TIMEOUT, CODEX_TIMEOUT
    ap = argparse.ArgumentParser(description="Claude <-> Codex debate to consensus.")
    ap.add_argument("question", nargs="*", help="the question (or pipe via stdin)")
    ap.add_argument("--max-rounds", type=int, default=6,
                    help="max full rounds (Claude+Codex) before giving up (default 6)")
    ap.add_argument("--quiet", action="store_true", help="hide Claude's thinking")
    ap.add_argument("--think", type=int, default=42000, metavar="TOKENS",
                    help="aggregate requested Claude thinking ceiling across "
                         "fresh research turns and synthesis; each call is "
                         "capped by --claude-tranche-think (default 42000)")
    ap.add_argument("--claude-tranche-think", type=int,
                    default=CLAUDE_TRANCHE_THINK, metavar="TOKENS",
                    help="max Claude extended-thinking tokens in one bounded "
                         f"micro-report tranche (default {CLAUDE_TRANCHE_THINK})")
    ap.add_argument("--save", metavar="FILE",
                    help="write the full transcript to FILE "
                         "(default: consensus_<timestamp>.md in the current directory)")
    ap.add_argument("--no-save", action="store_true", help="do not write a transcript file")
    ap.add_argument("--no-synthesize", action="store_true",
                    help="on consensus, print the last turn verbatim instead of a synthesized answer")
    ap.add_argument("--context", action="append", metavar="FILE", default=[],
                    help="include FILE's contents in every turn's prompt (repeatable)")
    ap.add_argument("--first", choices=("claude", "codex"), default="claude",
                    help="which model takes the opening turn (default claude)")
    ap.add_argument("--claude-timeout", "--claude-report-deadline",
                    dest="claude_report_deadline", type=int,
                    default=CLAUDE_REPORT_DEADLINE, metavar="SECS",
                    help="durable-work checkpoint interval for Claude research "
                         f"(default {CLAUDE_REPORT_DEADLINE}; five consecutive "
                         "misses terminate the live process; "
                         "--claude-timeout is retained as an alias)")
    ap.add_argument("--claude-recovery-timeout", type=int,
                    default=CLAUDE_RECOVERY_TIMEOUT, metavar="SECS",
                    help="hard deadline for each no-thinking recovery report "
                         f"(default {CLAUDE_RECOVERY_TIMEOUT})")
    ap.add_argument("--claude-turn-timeout", type=int,
                    default=CLAUDE_TURN_TIMEOUT, metavar="SECS",
                    help="absolute wall-clock cap for a live Claude research "
                         "turn or synthesis, regardless of stream activity "
                         f"(default {CLAUDE_TURN_TIMEOUT})")
    ap.add_argument("--codex-timeout", type=int, default=CODEX_TIMEOUT, metavar="SECS",
                    help=f"per-turn timeout for Codex, 0 = no limit (default {CODEX_TIMEOUT})")
    ap.add_argument("--progress", metavar="FILE",
                    help="durable checkpoint log (default: the transcript path "
                         "with .progress.md appended)")
    args = ap.parse_args()

    if args.claude_report_deadline <= 0:
        ap.error("the Claude checkpoint interval must be positive")
    if args.claude_recovery_timeout <= 0:
        ap.error("the Claude recovery timeout must be positive")
    if args.claude_turn_timeout <= 0:
        ap.error("the Claude turn timeout must be positive")
    CLAUDE_REPORT_DEADLINE = args.claude_report_deadline
    CLAUDE_RECOVERY_TIMEOUT = args.claude_recovery_timeout
    CLAUDE_TURN_TIMEOUT = args.claude_turn_timeout
    CODEX_TIMEOUT = args.codex_timeout

    question = " ".join(args.question).strip() or (
        sys.stdin.read().strip() if not sys.stdin.isatty() else "")
    if not question:
        ap.error("no question given (pass as argument or via stdin)")

    run_stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    if args.no_save:
        save_path = None
    else:
        save_path = args.save or os.path.join(
            os.getcwd(), f"consensus_{run_stamp}.md")
    progress_path = args.progress or (
        save_path + ".progress.md" if save_path else
        os.path.join(os.getcwd(), f"consensus_{run_stamp}_progress.md")
    )
    claude_work_path = progress_path + ".claude-stream.jsonl"
    protocol_path = progress_path + ".protocol.json"

    context = ""
    if args.context:
        parts = []
        for path in args.context:
            with open(path) as fh:
                parts.append(f"----- BEGIN {os.path.basename(path)} -----\n"
                             f"{fh.read()}\n----- END {os.path.basename(path)} -----")
        context = ("REFERENCE DOCUMENT(S) UNDER DISCUSSION (the question is about "
                   "these — read carefully):\n\n" + "\n\n".join(parts) + "\n\n")

    print(f"{SYS_COL}{BOLD}Question:{RESET} {question}")
    if args.context:
        print(f"{SYS_COL}Context: {', '.join(os.path.basename(p) for p in args.context)}{RESET}")
    print(f"{SYS_COL}Claude and Codex will debate until they agree "
          f"(max {args.max_rounds} rounds).{RESET}")
    claude_label = f"{CLAUDE_MODEL or 'machine default'}/{CLAUDE_EFFORT or 'default effort'}"
    codex_label = f"{CODEX_MODEL or 'machine default'}/{CODEX_REASONING_EFFORT or 'default effort'}"
    print(f"{SYS_COL}Models: Claude {claude_label}; Codex {codex_label}.{RESET}")
    print(f"{SYS_COL}Claude's durable stream journal is checked every "
          f"{CLAUDE_REPORT_DEADLINE}s; terminate the live process after "
          f"{CLAUDE_MAX_CONSECUTIVE_MISSES} consecutive silent intervals, then resume "
          f"the session for recovery.{RESET}")
    print(f"{SYS_COL}Every live Claude turn and synthesis also has an absolute "
          f"{CLAUDE_TURN_TIMEOUT}s cap, regardless of stream activity.{RESET}")
    print(f"{SYS_COL}Progress: {progress_path}{RESET}")
    print(f"{SYS_COL}Claude stream journal: {claude_work_path}{RESET}")
    print(f"{SYS_COL}Protocol manifest: {protocol_path}{RESET}")

    turns = []  # list of {"who","text","verdict"}
    consensus = False
    stalled = False
    claude_think_remaining = args.think

    progress_parent = os.path.dirname(os.path.abspath(progress_path))
    os.makedirs(progress_parent, exist_ok=True)
    runner_path = os.path.abspath(__file__)
    with open(runner_path, "rb") as runner_file:
        runner_hash = hashlib.sha256(runner_file.read()).hexdigest()
    manifest = {
        "protocol_version": PROTOCOL_VERSION,
        "runner": runner_path,
        "runner_sha256": runner_hash,
        "claude_activity_interval_seconds": CLAUDE_REPORT_DEADLINE,
        "claude_max_silent_intervals": CLAUDE_MAX_CONSECUTIVE_MISSES,
        "claude_turn_timeout_seconds": CLAUDE_TURN_TIMEOUT,
        "claude_recovery_timeout_seconds": CLAUDE_RECOVERY_TIMEOUT,
        "stream_activity_extends_absolute_deadline": False,
    }
    atomic_write(protocol_path, json.dumps(manifest, indent=2) + "\n")
    with open(progress_path, "w", encoding="utf-8") as progress:
        progress.write(f"# Consensus progress — {datetime.now():%Y-%m-%d %H:%M}\n\n")
        progress.write(f"Question: {question}\n\n")
        progress.write(
            f"Claude: {claude_label}; "
            f"stream activity interval: {CLAUDE_REPORT_DEADLINE}s; "
            f"absolute turn deadline: {CLAUDE_TURN_TIMEOUT}s; "
            f"recovery deadline: {CLAUDE_RECOVERY_TIMEOUT}s; "
            f"maximum consecutive misses: {CLAUDE_MAX_CONSECUTIVE_MISSES}\n\n"
        )
        progress.flush()
        os.fsync(progress.fileno())
    _fsync_directory(progress_path)
    journal_descriptor = os.open(
        claude_work_path,
        os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
        0o600,
    )
    os.fchmod(journal_descriptor, 0o600)
    with os.fdopen(journal_descriptor, "w", encoding="utf-8") as work:
        work.write(json.dumps({
            "type": "consensus_stream_journal",
            "created": datetime.now().isoformat(timespec="seconds"),
            "note": "Runner-owned fsynced journal of Claude stream events",
        }) + "\n")
        work.flush()
        os.fsync(work.fileno())
    _fsync_directory(claude_work_path)

    def append_progress(label, body):
        with open(progress_path, "a", encoding="utf-8") as progress:
            progress.write(f"## {datetime.now():%Y-%m-%d %H:%M:%S} — {label}\n\n")
            progress.write(body.rstrip() + "\n\n")
            progress.flush()
            os.fsync(progress.fileno())

    def claude_checkpoint_event(status, misses):
        if status == "observed":
            append_progress(
                "Claude stream activity observed",
                f"stream_journal: {claude_work_path}\n"
                "consecutive_silence_misses_reset: yes\n"
                "absolute_deadline_reset: no",
            )
        else:
            append_progress(
                f"Claude stream activity interval silent {misses}/"
                f"{CLAUDE_MAX_CONSECUTIVE_MISSES}",
                f"interval: {CLAUDE_REPORT_DEADLINE}s\n"
                f"stream_journal: {claude_work_path}",
            )

    def write_snapshot(outcome, final=None):
        if not save_path:
            return
        pieces = [
            f"# Consensus debate — {datetime.now():%Y-%m-%d %H:%M}\n\n",
            f"## Question\n{question}\n\n",
            f"## Models\nClaude: {claude_label}; Codex: {codex_label}\n\n",
            f"## Outcome\n{outcome}\n\n",
        ]
        if final:
            pieces.append(f"## Agreed answer\n{final}\n\n")
        for turn in turns:
            secs = turn.get("secs")
            tag = f", {fmt_dur(secs)}" if secs is not None else ""
            pieces.append(
                f"## {turn['who']}  (verdict: {turn['verdict']}{tag})\n"
                f"{turn['text']}\n\n"
            )
        atomic_write(save_path, "".join(pieces))

    current_round = 0
    consecutive_claude_misses = 0
    consecutive_no_progress = 0

    def claude_turn():
        nonlocal consecutive_claude_misses, consecutive_no_progress
        nonlocal claude_think_remaining
        p = build_prompt("Claude", "Codex", question, turns, opening=not turns,
                         context=context)
        t0 = time.perf_counter()
        tranche_think = min(
            claude_think_remaining,
            args.claude_tranche_think,
        )
        claude_think_remaining -= tranche_think
        thinking = ""
        answer = ""
        recovery_prompt = p
        session_id = str(uuid.uuid4())
        append_progress(
            "Claude research session started",
            f"session_id: {session_id}\nstream_journal: {claude_work_path}",
        )
        p += f"""

CLAUDE DURABILITY NOTICE:
The runner continuously journals your streamed events to an fsynced file and
retains this turn's resumable session ID. Do not modify project files merely to
checkpoint the debate. Emit concise cumulative status text before any extended
silent phase when possible, and return the required CHECKPOINT report. The
runner permits five consecutive {CLAUDE_REPORT_DEADLINE}-second intervals
without new streamed activity before it terminates the live process and
resumes this same session. Stream activity never extends the absolute
{CLAUDE_TURN_TIMEOUT}-second live-turn deadline.
"""
        recovery_prompt = p

        while consecutive_claude_misses < CLAUDE_MAX_CONSECUTIVE_MISSES:
            recovery = consecutive_claude_misses > 0
            deadline = (
                CLAUDE_RECOVERY_TIMEOUT if recovery
                else CLAUDE_TURN_TIMEOUT
            )
            think = 0 if recovery else tranche_think
            if recovery:
                recovery_prompt = p + f"""

EXTERNAL RECOVERY TRANCHE:
The preceding live research process reached its durability cutoff or failed to
return a valid checkpoint report. This is recovery attempt
{consecutive_claude_misses}/{CLAUDE_MAX_CONSECUTIVE_MISSES}. Do no new research,
delegate no work, and invoke no tools. Recover from this resumed session, the
debate transcript, and the durable stream journal; immediately return the required
CHECKPOINT block and a concise cumulative report. End with VERDICT: DISAGREE.
"""
            try:
                thinking, answer = run_claude(
                    recovery_prompt,
                    think,
                    timeout=deadline,
                    session_id=session_id,
                    resume=recovery,
                    checkpoint_file=(None if recovery else claude_work_path),
                    checkpoint_event=(None if recovery else claude_checkpoint_event),
                    stream_journal=claude_work_path,
                )
            except (subprocess.TimeoutExpired, RuntimeError) as error:
                if isinstance(error, SilentIntervalsExceeded) and not recovery:
                    consecutive_claude_misses = 1
                    append_progress(
                        "Claude live process terminated after five silent intervals",
                        f"interval: {CLAUDE_REPORT_DEADLINE}s\n"
                        f"session_id: {session_id}\n"
                        "action: resume same session for bounded recovery\n"
                        f"reason: {failure_summary(error)}",
                    )
                elif isinstance(error, subprocess.TimeoutExpired) and not recovery:
                    consecutive_claude_misses = 1
                    append_progress(
                        "Claude live process reached absolute turn deadline",
                        f"deadline: {CLAUDE_TURN_TIMEOUT}s\n"
                        f"session_id: {session_id}\n"
                        "stream_activity_extended_deadline: no\n"
                        "action: resume same session for bounded recovery\n"
                        f"reason: {failure_summary(error)}",
                    )
                else:
                    consecutive_claude_misses += 1
                    append_progress(
                        f"Claude recovery/validity failure "
                        f"{consecutive_claude_misses}/"
                        f"{CLAUDE_MAX_CONSECUTIVE_MISSES}",
                        f"deadline: {deadline or 'not applicable'}\n"
                        f"session_id: {session_id}\n"
                        f"reason: {failure_summary(error)}",
                    )
                if consecutive_claude_misses >= CLAUDE_MAX_CONSECUTIVE_MISSES:
                    raise RuntimeError(
                        f"Claude exhausted {CLAUDE_MAX_CONSECUTIVE_MISSES} "
                        "consecutive recovery/validity "
                        f"tranches; partial work is preserved in {progress_path}"
                    )
                continue

            checkpoint = checkpoint_of(answer)
            verdict = verdict_of(answer)
            if checkpoint is None or verdict is None:
                consecutive_claude_misses += 1
                reason = (
                    "missing or incomplete CHECKPOINT block"
                    if checkpoint is None else "missing trailing VERDICT"
                )
                append_progress(
                    f"Claude missed checkpoint {consecutive_claude_misses}/"
                    f"{CLAUDE_MAX_CONSECUTIVE_MISSES}",
                    f"deadline: {deadline}s\nreason: {reason}\n\n"
                    f"Returned text:\n{answer}",
                )
                if consecutive_claude_misses >= CLAUDE_MAX_CONSECUTIVE_MISSES:
                    raise RuntimeError(
                        f"Claude returned {CLAUDE_MAX_CONSECUTIVE_MISSES} "
                        "consecutive invalid checkpoint "
                        f"reports; partial work is preserved in {progress_path}"
                    )
                continue

            append_progress(
                "Claude checkpoint",
                f"wall_clock: {fmt_dur(time.perf_counter() - t0)}\n"
                f"recovery: {'yes' if recovery else 'no'}\n\n{answer}",
            )
            consecutive_claude_misses = 0
            if verdict == "DISAGREE" and no_substantive_progress(checkpoint):
                consecutive_no_progress += 1
            else:
                consecutive_no_progress = 0
            if consecutive_no_progress >= 2:
                dur = time.perf_counter() - t0
                turns.append({
                    "who": "Claude",
                    "text": answer,
                    "verdict": verdict,
                    "secs": dur,
                })
                append_progress(
                    "Debate stalled",
                    "Claude returned two consecutive completed DISAGREE "
                    "checkpoints with no substantive progress. The final "
                    "completed turn is retained.",
                )
                write_snapshot("NO CONSENSUS — STALLED (NO SUBSTANTIVE PROGRESS)")
                raise DebateStalled
            break

        dur = time.perf_counter() - t0
        turns.append({"who": "Claude", "text": answer,
                      "verdict": verdict_of(answer), "secs": dur})
        write_snapshot("IN PROGRESS")
        show("Claude", CLAUDE_COL, thinking, answer, args.quiet)
        print(f"{CLAUDE_COL}{DIM}  ⏱ Claude: {fmt_dur(dur)}{RESET}")

    def codex_turn():
        p = build_prompt("Codex", "Claude", question, turns, opening=not turns,
                         context=context)
        t0 = time.perf_counter()
        answer = ""
        verdict = None
        for attempt in range(1, 3):
            answer = run_codex(p)
            verdict = verdict_of(answer)
            if verdict is not None:
                break
            append_progress(
                f"Codex invalid report {attempt}/2",
                "Missing or malformed final VERDICT line; retrying."
                if attempt == 1 else
                "Missing or malformed final VERDICT line; aborting.",
            )
            p += (
                "\n\nYour prior report was rejected because it did not end "
                "with exactly VERDICT: AGREE or VERDICT: DISAGREE. Return a "
                "corrected cumulative report with an exact final verdict line."
            )
        if verdict is None:
            raise RuntimeError("Codex returned two invalid verdict reports")
        dur = time.perf_counter() - t0
        turns.append({"who": "Codex", "text": answer,
                      "verdict": verdict, "secs": dur})
        append_progress(
            "Codex turn completed",
            f"wall_clock: {fmt_dur(dur)}\nverdict: {verdict}",
        )
        write_snapshot("IN PROGRESS")
        show("Codex", CODEX_COL, "", answer, args.quiet)
        print(f"{CODEX_COL}{DIM}  ⏱ Codex: {fmt_dur(dur)}{RESET}")

    order = (claude_turn, codex_turn) if args.first == "claude" else (codex_turn, claude_turn)

    def interrupt_signal(_signum, _frame):
        raise KeyboardInterrupt

    for interruptible in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(interruptible, interrupt_signal)

    interrupted = False
    try:
        for rnd in range(1, args.max_rounds + 1):
            current_round = rnd
            print(f"\n{SYS_COL}{DIM}round {rnd}/{args.max_rounds}{RESET}")
            for step in order:
                step()
                if (len(turns) >= 2 and turns[-1]["verdict"] == "AGREE"
                        and turns[-2]["verdict"] == "AGREE"):
                    consensus = True
                    break
            if consensus:
                break
    except DebateStalled:
        stalled = True
        print(f"\n{SYS_COL}Debate stalled without substantive progress.{RESET}")
    except KeyboardInterrupt:
        interrupted = True
        print(f"\n{SYS_COL}Interrupted.{RESET}")
        append_progress("Run interrupted", "The user interrupted the debate.")
        write_snapshot("INTERRUPTED")
    except Exception as e:
        print(f"\n{BOLD}\033[31mError:{RESET} {e}", file=sys.stderr)
        append_progress("Run aborted", str(e))
        write_snapshot(f"ABORTED: {e}")
        sys.exit(1)

    if interrupted:
        print(f"{SYS_COL}Protocol files retained; no model process left running.{RESET}")
        return 130

    print()
    final_answer = None
    if consensus:
        print(f"{BOLD}\033[32m✓ CONSENSUS REACHED{RESET} after {len(turns)} turns.\n")
        if args.no_synthesize:
            final_answer = strip_verdict(turns[-1]["text"])
        else:
            transcript = "\n\n".join(f"--- {t['who']} said ---\n{t['text']}" for t in turns)
            synth_prompt = SYNTH.format(
                question=question,
                transcript=transcript,
                context=context,
                report_max_tokens=REPORT_MAX_TOKENS,
            )
            synth_session_id = str(uuid.uuid4())
            try:
                synth_started = time.perf_counter()
                append_progress(
                    "Claude synthesis session started",
                    f"session_id: {synth_session_id}\n"
                    f"stream_journal: {claude_work_path}",
                )
                synth_think = min(
                    claude_think_remaining,
                    args.claude_tranche_think,
                )
                claude_think_remaining -= synth_think
                _, final_answer = run_claude(
                    synth_prompt,
                    synth_think,
                    timeout=CLAUDE_TURN_TIMEOUT,
                    session_id=synth_session_id,
                    checkpoint_file=claude_work_path,
                    checkpoint_event=claude_checkpoint_event,
                    stream_journal=claude_work_path,
                )
                append_progress(
                    "Claude synthesis completed",
                    f"wall_clock: {fmt_dur(time.perf_counter() - synth_started)}",
                )
            except KeyboardInterrupt:
                append_progress(
                    "Run interrupted during synthesis",
                    "The active model process group was terminated.",
                )
                write_snapshot("INTERRUPTED DURING SYNTHESIS")
                print(f"\n{SYS_COL}Interrupted during synthesis.{RESET}")
                return 130
            except Exception as e:
                append_progress(
                    "Claude synthesis requires recovery",
                    f"session_id: {synth_session_id}\n"
                    f"reason: {failure_summary(e)}",
                )
                recovery_prompt = synth_prompt + """

SYNTHESIS RECOVERY:
The prior synthesis process ended before returning an acceptable answer. Do no
new research and invoke no tools. Resume this same synthesis session and
immediately return the best clean, self-contained synthesis already supported
by the agreed transcript. Return no checkpoint block and no VERDICT line.
"""
                try:
                    _, final_answer = run_claude(
                        recovery_prompt,
                        0,
                        timeout=CLAUDE_RECOVERY_TIMEOUT,
                        session_id=synth_session_id,
                        resume=True,
                        stream_journal=claude_work_path,
                    )
                    append_progress(
                        "Claude synthesis recovered",
                        f"session_id: {synth_session_id}\nrecovery: yes",
                    )
                except KeyboardInterrupt:
                    append_progress(
                        "Run interrupted during synthesis recovery",
                        "The active model process group was terminated.",
                    )
                    write_snapshot("INTERRUPTED DURING SYNTHESIS RECOVERY")
                    return 130
                except Exception as recovery_error:
                    print(
                        f"{SYS_COL}(synthesis and recovery failed; "
                        f"showing last agreed turn){RESET}"
                    )
                    append_progress(
                        "Claude synthesis recovery failed; durable agreed turn used",
                        f"session_id: {synth_session_id}\n"
                        f"reason: {failure_summary(recovery_error)}",
                    )
                    final_answer = strip_verdict(turns[-1]["text"])
        print(f"{BOLD}Agreed answer:{RESET}\n")
        print(textwrap.indent(final_answer, "  "))
    else:
        stalled_label = " (stalled)" if stalled else ""
        print(f"{BOLD}\033[33m✗ No consensus{stalled_label}{RESET} "
              f"after {len(turns)} turns. "
              f"Final positions:\n")
        for who, col in (("Claude", CLAUDE_COL), ("Codex", CODEX_COL)):
            last = next((t for t in reversed(turns) if t["who"] == who), None)
            if last:
                print(f"{col}{BOLD}{who}:{RESET}\n{textwrap.indent(strip_verdict(last['text']), '  ')}\n")

    # --- timing summary ---
    def total(who):
        return sum(t.get("secs", 0.0) for t in turns if t["who"] == who)
    c_tot, x_tot = total("Claude"), total("Codex")
    n_c = sum(1 for t in turns if t["who"] == "Claude")
    n_x = sum(1 for t in turns if t["who"] == "Codex")
    print(f"\n{BOLD}Time spent (wall-clock):{RESET}")
    print(f"  {CLAUDE_COL}Claude{RESET}: {fmt_dur(c_tot)} over {n_c} turn(s)"
          f"{f' (avg {fmt_dur(c_tot / n_c)})' if n_c else ''}")
    print(f"  {CODEX_COL}Codex{RESET} : {fmt_dur(x_tot)} over {n_x} turn(s)"
          f"{f' (avg {fmt_dur(x_tot / n_x)})' if n_x else ''}")
    print(f"  {SYS_COL}total debate: {fmt_dur(c_tot + x_tot)}{RESET}")

    if save_path:
        outcome = (
            "CONSENSUS REACHED" if consensus else
            "NO CONSENSUS — STALLED (NO SUBSTANTIVE PROGRESS)" if stalled else
            "NO CONSENSUS"
        )
        timing = (f"\n\nClaude: {fmt_dur(c_tot)} ({n_c} turns); "
                  f"Codex: {fmt_dur(x_tot)} ({n_x} turns); "
                  f"total: {fmt_dur(c_tot + x_tot)}")
        write_snapshot(outcome + timing, final_answer)
        print(f"\n{SYS_COL}Transcript saved to {save_path}{RESET}")
    append_progress(
        "Run completed",
        ("CONSENSUS REACHED" if consensus else
         "NO CONSENSUS — STALLED" if stalled else "NO CONSENSUS")
        + f"\nClaude: {fmt_dur(c_tot)} ({n_c} turns)"
        + f"\nCodex: {fmt_dur(x_tot)} ({n_x} turns)",
    )
    print(f"{SYS_COL}Progress saved to {progress_path}{RESET}")
    print(f"{SYS_COL}Private Claude stream journal saved to "
          f"{claude_work_path}{RESET}")
    print(f"{SYS_COL}Protocol manifest saved to {protocol_path}{RESET}")


if __name__ == "__main__":
    raise SystemExit(main())
